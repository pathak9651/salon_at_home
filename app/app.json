{
  "expo": {
    "name": "Salon At Home",
    "slug": "salon-at-home",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0ed7539d-960d-4070-b670-8e3db3076420",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": false,
      "translucent": false,
      "backgroundColor": "#06101a",
      "barStyle": "light-content"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Salon At Home uses your location to auto-fill saved service addresses."
      }
    },
    "android": {
      "package": "com.salonathome.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06101a"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salon At Home uses your location to auto-fill saved service addresses."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              {
                "url": "https://jitpack.io"
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ed7539d-960d-4070-b670-8e3db3076420"
      }
    }
  }
}
